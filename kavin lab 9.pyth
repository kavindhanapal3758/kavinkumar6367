1.math module tasks



# Task 1
print("Square root of 144 =", math.sqrt(144))
print("Power of 5³ =", math.pow(5,3))
print("Factorial of 6 =", math.factorial(6))

# Task 2
print("Ceil(5.2) =", math.ceil(5.2))
print("Floor(5.8) =", math.floor(5.8))
print("GCD(24,36) =", math.gcd(24,36))

# Task 3: 

num1 = float(input("Enter first number: "))
num2 = float(input("Enter second number: "))
operator = input("Enter operator (+,-,*,/): ")

if operator == "+":
    print("Result =", num1 + num2)

elif operator == "-":
    print("Result =", num1 - num2)

elif operator == "*":
    print("Result =", num1 * num2)

elif operator == "/":
    print("Result =", num1 / num2)

else:
    print("Invalid operator")



# 2. DATETIME MODULE TASKS


from datetime import datetime

now = datetime.now()

# Task 1
print("Current Date:", now.date())
print("Current Time:", now.time())
print("Current Year:", now.year)

# Task 2
dob = datetime(2008,5,15)   # Change your DOB

age = now.year - dob.year
print("Age =", age)

# Task 3
print("Today's Date =", now.strftime("%d-%m-%Y")
      
      
      
# 3. DATE MODULE TASKS


from datetime import date

# Task 1
birthday = date(2008,5,15)   # Change DOB
print("Birthday:", birthday)

# Task 2
today = date.today()

difference = today - birthday
print("Difference:", difference)

# Task 3
print("Day =", birthday.day)
print("Month =", birthday.month)
print("Year =", birthday.year)



# 4. CALENDAR MODULE TASKS


import calendar

# Task 1
print(calendar.month(today.year, today.month))

# Task 2
print(calendar.calendar(2026))

# Task 3
print("2024:", calendar.isleap(2024))
print("2025:", calendar.isleap(2025))
print("2028:", calendar.isleap(2028))

# Task 4
day_number = calendar.weekday(
    birthday.year,
    birthday.month,
    birthday.day
)

days = ["Monday","Tuesday",
        "Wednesday","Thursday",
        "Friday","Saturday",
        "Sunday"]

print("Birthday Weekday:",
      days[day_number])



